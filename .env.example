DB_SERVER=your-sql-server,1433
DB_DATABASE=your-database
DB_USER=your-user
DB_PASSWORD=your-password
DB_DRIVER={ODBC Driver 18 for SQL Server}
DB_TRUST_SERVER_CERTIFICATE=yes

REDIS_URL=redis://:url-encoded-password@your-redis-host:6379/0
TREE_CACHE_IDLE_SECONDS=60
TREE_CACHE_KEY_PREFIX=trial-balance:tree:
